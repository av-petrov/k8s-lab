# Скопировать в .local/config.env (игнорируется git) и заполнить.
GCP_PROJECT=
# для make gcp-budget: gcloud billing projects describe $GCP_PROJECT --format='value(billingAccountName)'
BILLING_ACCOUNT=
# куда слать алерты Monitoring и бюджета (пусто — только консоль / админы billing)
ALERT_EMAIL=
# сумма бюджета в валюте billing-аккаунта (по умолчанию 1)
BUDGET_AMOUNT=1
