# Зафиксированные версии. Определены через `helm search repo <chart> --versions` (stable, без pre-release) 2026-11-15.
# Здесь только то, что ставится вручную при bootstrap (helm). Версии компонентов под Argo CD —
# в targetRevision их Application (argocd/bootstrap/apps/*.yaml): один источник правды.
# Обновление: поменять версию → прочитать changelog → make <component>-diff → make <component>-upgrade.
KIND_NODE_IMAGE=kindest/node:v1.35.1@sha256:05d7bcdefbda08b4e038f644c4df690cdac3fba8b06f8289f30e10026720a1ab
CILIUM_CHART_VERSION=1.20.4
ARGOCD_CHART_VERSION=10.18.0
# helm-diff: v3.13+ требует Helm с поддержкой platformHooks (локальный Helm v3.16.3 — нет). После обновления Helm поднять.
HELM_DIFF_PLUGIN_VERSION=v3.12.5
