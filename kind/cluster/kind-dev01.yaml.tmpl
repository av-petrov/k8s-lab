# Шаблон kind-конфига кластера dev01. Рендерится cluster/create.sh в .build/kind-dev01.yaml:
#   __ROOT__   -> абсолютный путь к этой директории (kind требует абсолютный hostPath)
#   __IMAGE__  -> KIND_NODE_IMAGE из versions.env
# Отличия от ../dev01.yaml: kubeProxyMode: none (сервисы обслуживает Cilium KPR) и audit-логи apiserver.
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: dev01
networking:
  disableDefaultCNI: true   # CNI ставим сами (Cilium через Helm)
  kubeProxyMode: none       # без kube-proxy; без Cilium сервисы (включая 10.96.0.1) работать не будут
containerdConfigPatches:
  - |-
    [plugins."io.containerd.grpc.v1.cri".registry]
      config_path = "/etc/containerd/certs.d"
kubeadmConfigPatches:
  # kind v0.31 генерирует kubeadm config в v1beta3 (kubeadm сам конвертирует в v1beta4),
  # поэтому extraArgs — map. Patch с apiVersion v1beta4 kind молча пропускает (сопоставление по apiVersion+kind).
  # Проверено: KIND_FLAGS="-v 6" make cluster-create -> в логе "apiVersion: kubeadm.k8s.io/v1beta3".
  - |
    kind: ClusterConfiguration
    apiServer:
      extraArgs:
        audit-policy-file: /etc/kubernetes/audit/audit-policy.yaml
        audit-log-path: /var/log/kubernetes/audit/audit.log
        audit-log-format: json
        audit-log-maxage: "7"
        audit-log-maxbackup: "5"
        audit-log-maxsize: "100"
      extraVolumes:
        - name: audit-policy
          hostPath: /etc/kubernetes/audit/audit-policy.yaml
          mountPath: /etc/kubernetes/audit/audit-policy.yaml
          readOnly: true
          pathType: File
        - name: audit-logs
          hostPath: /var/log/kubernetes/audit
          mountPath: /var/log/kubernetes/audit
          readOnly: false
          pathType: DirectoryOrCreate
nodes:
  - role: control-plane
    image: __IMAGE__
    extraPortMappings:
      - containerPort: 80
        hostPort: 8080
        protocol: TCP
      - containerPort: 443
        hostPort: 8443
        protocol: TCP
    extraMounts:
      # Политика читается apiserver только при старте: после правки audit-policy.yaml
      # нужен рестарт apiserver (или пересоздание кластера).
      - hostPath: __ROOT__/audit/audit-policy.yaml
        containerPath: /etc/kubernetes/audit/audit-policy.yaml
        readOnly: true
  - role: worker
    image: __IMAGE__
  - role: worker
    image: __IMAGE__
