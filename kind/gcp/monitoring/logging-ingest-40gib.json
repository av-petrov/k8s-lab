{
  "displayName": "kind-dev01: Cloud Logging ingest > 40 GiB/month",
  "documentation": {
    "content": "Ingested logs this month exceeded 40 GiB of the 50 GiB free tier. Above 50 GiB: $0.50/GiB. Stop ingestion now: `make gcp-logging-off` (logs are dropped, not billed; agent still writes to stdout).",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "monthly_bytes_ingested > 40 GiB",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/billing/monthly_bytes_ingested\" AND resource.type=\"global\"",
        "aggregations": [
          {
            "alignmentPeriod": "3600s",
            "perSeriesAligner": "ALIGN_MAX",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 42949672960,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "604800s"
  },
  "severity": "CRITICAL",
  "userLabels": {
    "cluster": "kind-dev01",
    "purpose": "logging-budget"
  }
}
